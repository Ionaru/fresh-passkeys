{
  "name": "@ionaru/fresh-passkeys",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    "./server": "./src/server/mod.ts",
    "./client": "./src/client/mod.ts"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "fix": "deno fmt . && deno lint --fix .",
    "test": "deno test -A --parallel --coverage --import-map=tests/import-map.json",
    "coverage": "deno coverage --exclude=tests/"
  },
  "lint": {
    "rules": {
      "include": [
        "no-non-null-assertion",
        "eqeqeq",
        "no-process-global",
        "no-node-globals"
      ],
      "tags": [
        "workspace",
        "jsr",
        "fresh",
        "recommended"
      ]
    }
  },
  "imports": {
    "@simplewebauthn/browser": "jsr:@simplewebauthn/browser@^13.3.0",
    "@simplewebauthn/server": "jsr:@simplewebauthn/server@^13.3.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/testing": "jsr:@std/testing@^1.0.18",
    "fresh": "jsr:@fresh/core@^2.3.3"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedDeclarations": true,
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  }
}
